{
  "additionalProperties": false,
  "$id": "https://emberfall.local/schema/behaviors",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "items": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "tags",
          "mode",
          "detectionRange",
          "preferredRange",
          "strafe",
          "navigation"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "maxLength": 100,
            "type": "string"
          },
          "tags": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "maxLength": 160,
              "type": "string"
            }
          },
          "mode": {
            "anyOf": [
              {
                "const": "chase",
                "type": "string"
              },
              {
                "const": "ranged",
                "type": "string"
              },
              {
                "const": "orbit",
                "type": "string"
              },
              {
                "const": "guard",
                "type": "string"
              },
              {
                "const": "flee",
                "type": "string"
              }
            ]
          },
          "detectionRange": {
            "minimum": 1,
            "maximum": 2000,
            "default": 500,
            "type": "number"
          },
          "preferredRange": {
            "minimum": 0,
            "maximum": 1500,
            "default": 140,
            "type": "number"
          },
          "strafe": {
            "minimum": -1,
            "maximum": 1,
            "default": 0,
            "type": "number"
          },
          "navigation": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
