{
  "additionalProperties": false,
  "$id": "https://emberfall.local/schema/roomTemplates",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "items": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "tags",
          "tilemapId",
          "minDepth",
          "maxDepth"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "maxLength": 100,
            "type": "string"
          },
          "tags": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "maxLength": 160,
              "type": "string"
            }
          },
          "tilemapId": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string",
            "x-collection": "tilemaps"
          },
          "minDepth": {
            "minimum": 1,
            "maximum": 10000,
            "default": 1,
            "type": "integer"
          },
          "maxDepth": {
            "minimum": 1,
            "maximum": 10000,
            "default": 10000,
            "type": "integer"
          }
        }
      }
    }
  }
}
