{
  "additionalProperties": false,
  "$id": "https://emberfall.local/schema/attackPatterns",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "items": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "tags",
          "weaponId",
          "windupTicks",
          "recoveryTicks",
          "shots",
          "spreadDeg",
          "aim",
          "summonCount"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "maxLength": 100,
            "type": "string"
          },
          "tags": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "maxLength": 160,
              "type": "string"
            }
          },
          "weaponId": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string",
            "x-collection": "weapons"
          },
          "windupTicks": {
            "minimum": 0,
            "maximum": 1800,
            "default": 12,
            "type": "integer"
          },
          "recoveryTicks": {
            "minimum": 1,
            "maximum": 1800,
            "default": 30,
            "type": "integer"
          },
          "shots": {
            "minimum": 1,
            "maximum": 64,
            "default": 1,
            "type": "integer"
          },
          "spreadDeg": {
            "minimum": 0,
            "maximum": 360,
            "default": 0,
            "type": "number"
          },
          "aim": {
            "anyOf": [
              {
                "const": "target",
                "type": "string"
              },
              {
                "const": "radial",
                "type": "string"
              },
              {
                "const": "sweep",
                "type": "string"
              }
            ]
          },
          "summonEnemyId": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string",
            "x-collection": "enemies"
          },
          "summonCount": {
            "minimum": 0,
            "maximum": 20,
            "default": 0,
            "type": "integer"
          }
        }
      }
    }
  }
}
