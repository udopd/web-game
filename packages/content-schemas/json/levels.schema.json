{
  "additionalProperties": false,
  "$id": "https://emberfall.local/schema/levels",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "items": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "tags",
          "biomeId",
          "generationMode",
          "enemySpawnTableId",
          "decorationSpawnTableId",
          "chestSpawnTableId",
          "difficultyBudget"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "maxLength": 100,
            "type": "string"
          },
          "tags": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "maxLength": 160,
              "type": "string"
            }
          },
          "biomeId": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string",
            "x-collection": "biomes"
          },
          "generationMode": {
            "anyOf": [
              {
                "const": "handcrafted",
                "type": "string"
              },
              {
                "const": "procedural",
                "type": "string"
              },
              {
                "const": "hybrid",
                "type": "string"
              }
            ]
          },
          "tilemapId": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string",
            "x-collection": "tilemaps"
          },
          "generationRuleId": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string",
            "x-collection": "generationRules"
          },
          "enemySpawnTableId": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string",
            "x-collection": "enemySpawnTables"
          },
          "decorationSpawnTableId": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string",
            "x-collection": "decorationSpawnTables"
          },
          "chestSpawnTableId": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string",
            "x-collection": "chestSpawnTables"
          },
          "bossId": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string",
            "x-collection": "bosses"
          },
          "difficultyBudget": {
            "minimum": 0,
            "maximum": 10000,
            "default": 50,
            "type": "number"
          }
        }
      }
    }
  }
}
