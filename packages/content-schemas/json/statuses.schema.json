{
  "additionalProperties": false,
  "$id": "https://emberfall.local/schema/statuses",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "items": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "tags",
          "durationTicks",
          "tickInterval",
          "damagePerTick",
          "damageTypeId",
          "speedMultiplier",
          "stun"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "maxLength": 100,
            "type": "string"
          },
          "tags": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "maxLength": 160,
              "type": "string"
            }
          },
          "durationTicks": {
            "minimum": 1,
            "maximum": 3600,
            "default": 90,
            "type": "integer"
          },
          "tickInterval": {
            "minimum": 1,
            "maximum": 3600,
            "default": 30,
            "type": "integer"
          },
          "damagePerTick": {
            "minimum": 0,
            "maximum": 1000,
            "default": 0,
            "type": "number"
          },
          "damageTypeId": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string",
            "x-collection": "damageTypes"
          },
          "speedMultiplier": {
            "minimum": 0,
            "maximum": 5,
            "default": 1,
            "type": "number"
          },
          "stun": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
