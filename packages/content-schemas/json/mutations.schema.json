{
  "additionalProperties": false,
  "$id": "https://emberfall.local/schema/mutations",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "items": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "tags",
          "description",
          "iconSpriteId",
          "maxStacks",
          "weight",
          "effectIds"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "maxLength": 100,
            "type": "string"
          },
          "tags": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "maxLength": 160,
              "type": "string"
            }
          },
          "description": {
            "maxLength": 160,
            "type": "string"
          },
          "iconSpriteId": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string",
            "x-collection": "sprites"
          },
          "maxStacks": {
            "minimum": 1,
            "maximum": 10,
            "default": 1,
            "type": "integer"
          },
          "weight": {
            "minimum": 0.01,
            "maximum": 10000,
            "default": 1,
            "type": "number"
          },
          "effectIds": {
            "minItems": 1,
            "maxItems": 16,
            "type": "array",
            "items": {
              "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
              "type": "string",
              "x-collection": "effects"
            }
          }
        }
      }
    }
  }
}
