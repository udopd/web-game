{
  "additionalProperties": false,
  "$id": "https://emberfall.local/schema/campaigns",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "items": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "tags",
          "startNodeId",
          "endless",
          "maxRepeats",
          "nodes",
          "edges"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "maxLength": 100,
            "type": "string"
          },
          "tags": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "maxLength": 160,
              "type": "string"
            }
          },
          "startNodeId": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "endless": {
            "type": "boolean"
          },
          "maxRepeats": {
            "minimum": 0,
            "maximum": 10000,
            "default": 0,
            "type": "integer"
          },
          "nodes": {
            "minItems": 1,
            "maxItems": 256,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "nodeId",
                "kind",
                "unlockRuleIds",
                "difficultyScale"
              ],
              "properties": {
                "nodeId": {
                  "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                  "type": "string"
                },
                "kind": {
                  "anyOf": [
                    {
                      "const": "level",
                      "type": "string"
                    },
                    {
                      "const": "boss",
                      "type": "string"
                    },
                    {
                      "const": "milestone",
                      "type": "string"
                    },
                    {
                      "const": "end",
                      "type": "string"
                    }
                  ]
                },
                "levelId": {
                  "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                  "type": "string",
                  "x-collection": "levels"
                },
                "unlockRuleIds": {
                  "maxItems": 32,
                  "type": "array",
                  "items": {
                    "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                    "type": "string",
                    "x-collection": "unlocks"
                  }
                },
                "difficultyScale": {
                  "minimum": 0.1,
                  "maximum": 20,
                  "default": 1,
                  "type": "number"
                }
              }
            }
          },
          "edges": {
            "maxItems": 512,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "edgeId",
                "fromNodeId",
                "toNodeId",
                "selection",
                "weight"
              ],
              "properties": {
                "edgeId": {
                  "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                  "type": "string"
                },
                "fromNodeId": {
                  "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                  "type": "string"
                },
                "toNodeId": {
                  "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                  "type": "string"
                },
                "selection": {
                  "anyOf": [
                    {
                      "const": "always",
                      "type": "string"
                    },
                    {
                      "const": "weighted_random",
                      "type": "string"
                    },
                    {
                      "const": "player_choice",
                      "type": "string"
                    },
                    {
                      "const": "condition",
                      "type": "string"
                    }
                  ]
                },
                "weight": {
                  "minimum": 0.001,
                  "maximum": 10000,
                  "default": 1,
                  "type": "number"
                },
                "condition": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "type",
                        "levelId"
                      ],
                      "properties": {
                        "type": {
                          "const": "level_completed",
                          "type": "string"
                        },
                        "levelId": {
                          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                          "type": "string",
                          "x-collection": "levels"
                        }
                      }
                    },
                    {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "type",
                        "biomeId"
                      ],
                      "properties": {
                        "type": {
                          "const": "biome_completed",
                          "type": "string"
                        },
                        "biomeId": {
                          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                          "type": "string",
                          "x-collection": "biomes"
                        }
                      }
                    },
                    {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "type",
                        "bossId"
                      ],
                      "properties": {
                        "type": {
                          "const": "boss_defeated",
                          "type": "string"
                        },
                        "bossId": {
                          "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                          "type": "string",
                          "x-collection": "bosses"
                        }
                      }
                    },
                    {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "type",
                        "levelNumber"
                      ],
                      "properties": {
                        "type": {
                          "const": "max_level_reached",
                          "type": "string"
                        },
                        "levelNumber": {
                          "minimum": 1,
                          "maximum": 10000,
                          "default": 0,
                          "type": "integer"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
