{
  "additionalProperties": false,
  "$id": "https://emberfall.local/schema/sprites",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "items": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "tags",
          "source",
          "frame",
          "pivot",
          "renderScale",
          "rotationOffsetDeg",
          "layer"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "maxLength": 100,
            "type": "string"
          },
          "tags": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "maxLength": 160,
              "type": "string"
            }
          },
          "source": {
            "pattern": "^assets/[a-zA-Z0-9_./-]+\\.(png|webp)$",
            "type": "string"
          },
          "frame": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "properties": {
              "x": {
                "minimum": 0,
                "maximum": 100000,
                "default": 0,
                "type": "integer"
              },
              "y": {
                "minimum": 0,
                "maximum": 100000,
                "default": 0,
                "type": "integer"
              },
              "width": {
                "minimum": 1,
                "maximum": 4096,
                "default": 32,
                "type": "integer"
              },
              "height": {
                "minimum": 1,
                "maximum": 4096,
                "default": 32,
                "type": "integer"
              }
            }
          },
          "pivot": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "minimum": -100000,
                "maximum": 100000,
                "default": 0,
                "type": "number"
              },
              "y": {
                "minimum": -100000,
                "maximum": 100000,
                "default": 0,
                "type": "number"
              }
            }
          },
          "renderScale": {
            "minimum": 0.01,
            "maximum": 16,
            "default": 1,
            "type": "number"
          },
          "rotationOffsetDeg": {
            "minimum": -360,
            "maximum": 360,
            "default": 0,
            "type": "number"
          },
          "layer": {
            "anyOf": [
              {
                "const": "floor",
                "type": "string"
              },
              {
                "const": "props",
                "type": "string"
              },
              {
                "const": "characters",
                "type": "string"
              },
              {
                "const": "vfx_front",
                "type": "string"
              },
              {
                "const": "ui",
                "type": "string"
              }
            ]
          }
        }
      }
    }
  }
}
