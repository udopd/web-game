{
  "additionalProperties": false,
  "$id": "https://emberfall.local/schema/beams",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "items": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "tags",
          "range",
          "width",
          "damage",
          "damageTypeId",
          "pierce",
          "color",
          "durationTicks"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "maxLength": 100,
            "type": "string"
          },
          "tags": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "maxLength": 160,
              "type": "string"
            }
          },
          "range": {
            "minimum": 1,
            "maximum": 2000,
            "default": 300,
            "type": "number"
          },
          "width": {
            "minimum": 1,
            "maximum": 100,
            "default": 4,
            "type": "number"
          },
          "damage": {
            "minimum": 0,
            "maximum": 10000,
            "default": 8,
            "type": "number"
          },
          "damageTypeId": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string",
            "x-collection": "damageTypes"
          },
          "pierce": {
            "minimum": 0,
            "maximum": 100,
            "default": 0,
            "type": "integer"
          },
          "color": {
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "durationTicks": {
            "minimum": 1,
            "maximum": 300,
            "default": 3,
            "type": "integer"
          }
        }
      }
    }
  }
}
