{
  "additionalProperties": false,
  "$id": "https://emberfall.local/schema/props",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "items": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "tags",
          "spriteId",
          "collision",
          "blocksMovement",
          "blocksProjectiles",
          "blocksLineOfSight",
          "destructible",
          "maxHealth",
          "resistances"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "maxLength": 100,
            "type": "string"
          },
          "tags": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "maxLength": 160,
              "type": "string"
            }
          },
          "spriteId": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string",
            "x-collection": "sprites"
          },
          "destroyedSpriteId": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string",
            "x-collection": "sprites"
          },
          "collision": {
            "anyOf": [
              {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "shape",
                  "radius"
                ],
                "properties": {
                  "shape": {
                    "const": "circle",
                    "type": "string"
                  },
                  "radius": {
                    "minimum": 1,
                    "maximum": 128,
                    "default": 10,
                    "type": "number"
                  }
                }
              },
              {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "shape",
                  "width",
                  "height"
                ],
                "properties": {
                  "shape": {
                    "const": "box",
                    "type": "string"
                  },
                  "width": {
                    "minimum": 1,
                    "maximum": 256,
                    "default": 20,
                    "type": "number"
                  },
                  "height": {
                    "minimum": 1,
                    "maximum": 256,
                    "default": 20,
                    "type": "number"
                  }
                }
              }
            ]
          },
          "blocksMovement": {
            "type": "boolean"
          },
          "blocksProjectiles": {
            "type": "boolean"
          },
          "blocksLineOfSight": {
            "type": "boolean"
          },
          "destructible": {
            "type": "boolean"
          },
          "maxHealth": {
            "minimum": 1,
            "maximum": 100000,
            "default": 25,
            "type": "number"
          },
          "resistances": {
            "type": "object",
            "patternProperties": {
              "^[a-z][a-z0-9_.-]{0,79}$": {
                "minimum": 0,
                "maximum": 10,
                "default": 0,
                "type": "number"
              }
            }
          },
          "rewards": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "dropRuleId",
              "lootTableId"
            ],
            "properties": {
              "dropRuleId": {
                "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                "type": "string",
                "x-collection": "dropRules"
              },
              "lootTableId": {
                "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                "type": "string",
                "x-collection": "lootTables"
              }
            }
          }
        }
      }
    }
  }
}
