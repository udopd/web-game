{
  "additionalProperties": false,
  "$id": "https://emberfall.local/schema/chestSpawnTables",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "items": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "tags",
          "kind",
          "entries",
          "min",
          "max",
          "chance",
          "attempts",
          "minDistance"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "maxLength": 100,
            "type": "string"
          },
          "tags": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "maxLength": 160,
              "type": "string"
            }
          },
          "kind": {
            "anyOf": [
              {
                "const": "enemy",
                "type": "string"
              },
              {
                "const": "prop",
                "type": "string"
              },
              {
                "const": "chest",
                "type": "string"
              }
            ]
          },
          "entries": {
            "maxItems": 256,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "definitionId",
                "weight",
                "probability"
              ],
              "properties": {
                "definitionId": {
                  "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                  "type": "string"
                },
                "weight": {
                  "minimum": 0.001,
                  "maximum": 100000,
                  "default": 1,
                  "type": "number"
                },
                "probability": {
                  "minimum": 0,
                  "maximum": 1,
                  "default": 1,
                  "type": "number"
                }
              }
            }
          },
          "min": {
            "minimum": 0,
            "maximum": 200,
            "default": 0,
            "type": "integer"
          },
          "max": {
            "minimum": 0,
            "maximum": 200,
            "default": 8,
            "type": "integer"
          },
          "chance": {
            "minimum": 0,
            "maximum": 1,
            "default": 1,
            "type": "number"
          },
          "attempts": {
            "minimum": 1,
            "maximum": 1000,
            "default": 100,
            "type": "integer"
          },
          "minDistance": {
            "minimum": 0,
            "maximum": 1000,
            "default": 64,
            "type": "number"
          }
        }
      }
    }
  }
}
