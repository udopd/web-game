{
  "additionalProperties": false,
  "$id": "https://emberfall.local/schema/chests",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "items": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "tags",
          "spriteId",
          "animationSet",
          "collision",
          "interaction",
          "rewards",
          "policy"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "maxLength": 100,
            "type": "string"
          },
          "tags": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "maxLength": 160,
              "type": "string"
            }
          },
          "spriteId": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string",
            "x-collection": "sprites"
          },
          "animationSet": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "idle"
            ],
            "properties": {
              "idle": {
                "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                "type": "string",
                "x-collection": "animations"
              },
              "run": {
                "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                "type": "string",
                "x-collection": "animations"
              },
              "hurt": {
                "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                "type": "string",
                "x-collection": "animations"
              },
              "death": {
                "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                "type": "string",
                "x-collection": "animations"
              },
              "victory": {
                "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                "type": "string",
                "x-collection": "animations"
              },
              "windup": {
                "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                "type": "string",
                "x-collection": "animations"
              },
              "attack": {
                "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                "type": "string",
                "x-collection": "animations"
              },
              "open": {
                "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                "type": "string",
                "x-collection": "animations"
              }
            }
          },
          "collision": {
            "anyOf": [
              {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "shape",
                  "radius"
                ],
                "properties": {
                  "shape": {
                    "const": "circle",
                    "type": "string"
                  },
                  "radius": {
                    "minimum": 1,
                    "maximum": 128,
                    "default": 10,
                    "type": "number"
                  }
                }
              },
              {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "shape",
                  "width",
                  "height"
                ],
                "properties": {
                  "shape": {
                    "const": "box",
                    "type": "string"
                  },
                  "width": {
                    "minimum": 1,
                    "maximum": 256,
                    "default": 20,
                    "type": "number"
                  },
                  "height": {
                    "minimum": 1,
                    "maximum": 256,
                    "default": 20,
                    "type": "number"
                  }
                }
              }
            ]
          },
          "interaction": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "mode",
              "radius",
              "openTicks"
            ],
            "properties": {
              "mode": {
                "anyOf": [
                  {
                    "const": "interact",
                    "type": "string"
                  },
                  {
                    "const": "damage",
                    "type": "string"
                  },
                  {
                    "const": "proximity",
                    "type": "string"
                  }
                ]
              },
              "radius": {
                "minimum": 1,
                "maximum": 200,
                "default": 40,
                "type": "number"
              },
              "openTicks": {
                "minimum": 0,
                "maximum": 1800,
                "default": 10,
                "type": "integer"
              }
            }
          },
          "rewards": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "dropRuleId",
              "lootTableId"
            ],
            "properties": {
              "dropRuleId": {
                "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                "type": "string",
                "x-collection": "dropRules"
              },
              "lootTableId": {
                "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
                "type": "string",
                "x-collection": "lootTables"
              }
            }
          },
          "policy": {
            "anyOf": [
              {
                "const": "shared_world",
                "type": "string"
              },
              {
                "const": "individual_instanced",
                "type": "string"
              }
            ]
          }
        }
      }
    }
  }
}
