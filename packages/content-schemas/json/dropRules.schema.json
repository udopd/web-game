{
  "additionalProperties": false,
  "$id": "https://emberfall.local/schema/dropRules",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "items": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "tags",
          "baseChance",
          "slopePerPoint",
          "baseline",
          "minMultiplier",
          "maxMultiplier",
          "levelMultiplier",
          "coopMultiplier",
          "rollsMin",
          "rollsMax",
          "guaranteedDrop"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "maxLength": 100,
            "type": "string"
          },
          "tags": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "maxLength": 160,
              "type": "string"
            }
          },
          "baseChance": {
            "minimum": 0,
            "maximum": 1,
            "default": 0.25,
            "type": "number"
          },
          "slopePerPoint": {
            "minimum": -1,
            "maximum": 1,
            "default": 0.0125,
            "type": "number"
          },
          "baseline": {
            "minimum": 0,
            "maximum": 100,
            "default": 1,
            "type": "number"
          },
          "minMultiplier": {
            "minimum": 0,
            "maximum": 10,
            "default": 0.5,
            "type": "number"
          },
          "maxMultiplier": {
            "minimum": 0,
            "maximum": 10,
            "default": 2.25,
            "type": "number"
          },
          "levelMultiplier": {
            "minimum": 0,
            "maximum": 10,
            "default": 1,
            "type": "number"
          },
          "coopMultiplier": {
            "minimum": 0,
            "maximum": 10,
            "default": 1,
            "type": "number"
          },
          "rollsMin": {
            "minimum": 1,
            "maximum": 100,
            "default": 1,
            "type": "integer"
          },
          "rollsMax": {
            "minimum": 1,
            "maximum": 100,
            "default": 1,
            "type": "integer"
          },
          "guaranteedDrop": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
