{
  "additionalProperties": false,
  "$id": "https://emberfall.local/schema/projectiles",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "items": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "tags",
          "spriteId",
          "speed",
          "acceleration",
          "radius",
          "damage",
          "damageTypeId",
          "lifetimeTicks",
          "pierce",
          "ricochets",
          "explosionRadius",
          "gravity",
          "drag",
          "homing"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "maxLength": 100,
            "type": "string"
          },
          "tags": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "maxLength": 160,
              "type": "string"
            }
          },
          "spriteId": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string",
            "x-collection": "sprites"
          },
          "speed": {
            "minimum": 1,
            "maximum": 3000,
            "default": 400,
            "type": "number"
          },
          "acceleration": {
            "minimum": -2000,
            "maximum": 2000,
            "default": 0,
            "type": "number"
          },
          "radius": {
            "minimum": 0.5,
            "maximum": 64,
            "default": 3,
            "type": "number"
          },
          "damage": {
            "minimum": 0,
            "maximum": 10000,
            "default": 10,
            "type": "number"
          },
          "damageTypeId": {
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$",
            "type": "string",
            "x-collection": "damageTypes"
          },
          "lifetimeTicks": {
            "minimum": 1,
            "maximum": 1800,
            "default": 90,
            "type": "integer"
          },
          "pierce": {
            "minimum": 0,
            "maximum": 100,
            "default": 0,
            "type": "integer"
          },
          "ricochets": {
            "minimum": 0,
            "maximum": 20,
            "default": 0,
            "type": "integer"
          },
          "explosionRadius": {
            "minimum": 0,
            "maximum": 500,
            "default": 0,
            "type": "number"
          },
          "gravity": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "minimum": -100000,
                "maximum": 100000,
                "default": 0,
                "type": "number"
              },
              "y": {
                "minimum": -100000,
                "maximum": 100000,
                "default": 0,
                "type": "number"
              }
            }
          },
          "drag": {
            "minimum": 0,
            "maximum": 10,
            "default": 0,
            "type": "number"
          },
          "homing": {
            "minimum": 0,
            "maximum": 10,
            "default": 0,
            "type": "number"
          }
        }
      }
    }
  }
}
