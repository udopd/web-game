{
  "name": "emberfall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch apps/server/src/main.ts",
    "build": "npm run generate && tsc --noEmit && vite build --config apps/game-client/vite.config.ts && vite build --config apps/editor/vite.config.ts",
    "generate": "prisma generate && tsx scripts/generate-extension-registry.ts && tsx scripts/generate-validators.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:replay": "vitest run tests/simulation",
    "content:validate": "tsx scripts/content-validate.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "start": "tsx apps/server/src/main.ts",
    "requirements": "node scripts/requirements.mjs",
    "mutation:generate-registry": "tsx scripts/generate-extension-registry.ts && tsx scripts/generate-validators.ts",
    "mutation:create": "tsx scripts/mutation-create.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "@fastify/websocket": "11.3.4",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sinclair/typebox": "0.34.52",
    "@xyflow/react": "12.12.0",
    "ajv": "8.20.0",
    "dockview-react": "8.6.1",
    "dotenv": "18.0.8",
    "fastify": "5.12.7",
    "file-type": "22.2.0",
    "lucide-react": "1.61.0",
    "music-metadata": "12.2.3",
    "pg": "8.23.1",
    "phaser": "3.90.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "ws": "8.22.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
